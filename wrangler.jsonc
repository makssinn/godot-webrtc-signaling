{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "godot-webrtc-signaling",
  "main": "server.js",
  "compatibility_date": "2026-09-15",

  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNALING",
        "class_name": "SignalingRoom"
      }
    ]
  },

  "exports": {
    "SignalingRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
